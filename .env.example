# Copy this file to a file called .env (same folder) and fill in your own values.
# .env is in .gitignore: it must NEVER be committed to Git. Only this example file is.
#
# Make a good secret by running this in the terminal, once for each secret:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"

# Signs LOGIN tokens. At least 16 characters. Keep it the same between restarts so people stay logged in.
TOKEN_SECRET=

# Signs the QR codes on tickets. At least 16 characters. It must be DIFFERENT from TOKEN_SECRET.
# If it changes, every QR code printed or shown before the change stops working.
TICKET_SECRET=

# Set to production when the site is really live. Then the server refuses to start without both secrets.
# NODE_ENV=production

# Optional. Defaults: port 3000, database file data/tickets.sqlite
# PORT=3000
# DB_FILE=data/tickets.sqlite
